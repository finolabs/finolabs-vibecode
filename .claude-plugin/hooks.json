{
  "description": "Remind every new or resumed session to start coding work with fnl-coding-router",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/AGENTS.md\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
