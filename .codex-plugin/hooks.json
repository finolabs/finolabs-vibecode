{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}/scripts/update_check.py\" 2>/dev/null; exit 0",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/metrics_hook.py\" --host codex; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/metrics_hook.py\" --host codex; exit 0",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/metrics_hook.py\" --host codex; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
