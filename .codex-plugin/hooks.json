{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/metrics_hook.py\" --host codex; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/session_start.py\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/metrics_hook.py\" --host codex; exit 0",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${PLUGIN_ROOT:-$CODEX_PLUGIN_ROOT}\"; [ -n \"$r\" ] && python3 -I \"$r/scripts/metrics_hook.py\" --host codex; exit 0",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
